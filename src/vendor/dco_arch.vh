// GENERATED by scripts/gen_dco_rtl.py from matlab/m2_dco/dco_arch.py.
// Do not edit: `make m2` regenerates this file and fails if the copy
// in the tree differs from what the architecture definition implies.

// dco_arch.vh — the code word's shape, shared by every module that touches it
// (adpll_core, updn_integrator, dco_model, adpll_top and the testbenches).
//
// The code is bit-sliced coarse|mid|fine. Note that this packed word is NOT
// monotonic in frequency, and in V2 that is deliberate: the fine bank OVERLAPS
// a mid step (it spans ~2.8 of them at 500 MHz), which is precisely what
// removes the dead zones — and it also means a plain binary increment across a
// fine-field boundary steps backwards. The integrator therefore never walks
// the packed word; it walks the banks and crosses seams with {+-bank,
// re-center}. The re-center constants live in dco_params.vh because they are
// derived from the MEASURED step sizes, not from the code geometry.
`ifndef DCO_ARCH_VH
`define DCO_ARCH_VH
`define DCO_N_STG      5
`define DCO_CODE_W     15
`define DCO_COARSE_CODES  7      // thermometer bus width
`define DCO_COARSE_W      3
`define DCO_COARSE_LSB    12
`define DCO_COARSE_MSB    14
`define DCO_MID_CODES  31      // thermometer bus width
`define DCO_MID_W      5
`define DCO_MID_LSB    7
`define DCO_MID_MSB    11
`define DCO_FINE_CODES  95      // thermometer bus width
`define DCO_FINE_W      7
`define DCO_FINE_LSB    0
`define DCO_FINE_MSB    6

// Mid-scale reset (DR-005): each bank starts at the middle of its own
// field, which for this article is ~547 MHz — within 10 % of the 500 MHz
// target, so acquisition starts near the answer instead of a bank-end.
`define DCO_COARSE_RST   3   // documentation; the packed constant below is what the RTL uses
`define DCO_MID_RST   15   // documentation; the packed constant below is what the RTL uses
`define DCO_FINE_RST   47   // documentation; the packed constant below is what the RTL uses
`define DCO_RESET_CODE 15'd14255   // coarse=3 mid=15 fine=47

// Gear encoding for updn_integrator: which bank one window may move.
// A bank-wise gear (rather than V1's step-in-fine-LSBs) is what keeps
// acquisition fast now that the code is 14 bits and the fine LSB is
// 0.2 MHz: stepping the right bank costs ONE carry, never a divide.
`define GEAR_FINE1     2'd0
`define GEAR_FINE4     2'd1
`define GEAR_MID       2'd2
`define GEAR_COARSE    2'd3
`define GEAR_FINE_STEP 4
`endif
